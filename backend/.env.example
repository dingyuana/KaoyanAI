# ⚠️ 安全警告：请勿将真实 API Key 填入此文件！
# 复制此文件为 .env（已在 .gitignore 中排除），然后编辑 .env
#
#   cp .env.example .env
#   vim .env              # 填入真实 Key
#
# .env 文件包含敏感凭据，永远不会被提交到 git。
# 如果 Key 意外泄露，请立即到对应平台吊销并重新生成。

# ── LLM 配置 ──────────────────────────────────────────
# 必填：填入你的 API Key，留空则启用 Mock 模式
LLM_API_KEY=your_api_key_here

# API 地址（OpenAI 兼容接口）
LLM_BASE_URL=https://api.minimaxi.com/v1

# 模型名称
LLM_MODEL=MiniMax-M2.7

# 其他选项（可选）：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
